# agent-runtime 로컬 실행용 환경변수 템플릿.
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 .gitignore로 무시된다.
# 이미 설정된 실제 환경변수가 .env보다 우선한다.

# 선택: 사용할 LLM provider. 미지정 시 ollama. 지원 값: ollama, claude.
LLM_PROVIDER=

# 필수: provider 호출에 사용할 모델. 예: llama3.2, claude-sonnet-4-5.
LLM_MODEL=

# ollama 필수: LLM 서버 호스트 URL. 미지정 시 기본값 http://localhost:11434. claude는 사용하지 않는다.
LLM_HOST=

# claude 필수: Claude API key. ollama는 사용하지 않는다.
LLM_API_KEY=

# 선택: LLM 호출 timeout (Go duration 형식, 예: 30s, 1500ms. 미지정 시 기본값 30s)
LLM_TIMEOUT=

# 선택: Tavily Web Search Tool API key. 미지정 시 web_search tool 호출만 error result로 반환한다.
TAVILY_API_KEY=

# 선택: CLI Code Execution Tool 활성화 여부. 미지정 시 false.
ENABLE_CODE_EXECUTION=false

# 선택: CLI 기본 로그 레벨. 미지정 시 info.
LOG_LEVEL=
